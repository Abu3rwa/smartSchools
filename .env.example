# Server Configuration
PORT=5000
NODE_ENV=development

# MongoDB Configuration
MONGODB_URI=mongodb://localhost:27017/gradebook

# JWT Configuration
JWT_SECRET=your_super_secret_jwt_key_change_in_productionnn
JWT_EXPIRE=7d

# Email Configuration (for notifications)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
FROM_EMAIL=noreply@gradebook.com
FROM_NAME=GradeBook

# Google OAuth Configuration (for Gmail API + Login)
# Get these from Google Cloud Console: https://console.cloud.google.com/
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_REDIRECT_URI=http://localhost:5000/api/auth/gmail/callback
GOOGLE_LOGIN_REDIRECT_URI=http://localhost:5000/api/auth/google/callback

# Frontend URL (for CORS)
CLIENT_URL=http://localhost:5173
