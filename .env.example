# # Server Configuration
# PORT=5000
# NODE_ENV=development

# # MongoDB Configuration
# MONGODB_URI=mongodb://localhost:27017/gradebook

# # JWT Configuration
# JWT_SECRET=your_super_secret_jwt_key_change_in_productionnn
# JWT_EXPIRE=7d
# JWT_REFRESH_SECRET=your_refresh_secret_change_in_production
# JWT_REFRESH_EXPIRE=30d

# # Email Configuration (for notifications)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your_email@gmail.com
# SMTP_PASS=your_app_password
# FROM_EMAIL=noreply@gradebook.com
# FROM_NAME=GradeBook

# # Google OAuth Configuration (for Gmail API + Login)
# # Get these from Google Cloud Console: https://console.cloud.google.com/
# GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
# GOOGLE_CLIENT_SECRET=your_google_client_secret
# # Redirect URIs must match exactly what you set in Google Cloud Console → APIs → Credentials → OAuth 2.0
# # GOOGLE_REDIRECT_URI=http://localhost:5000/api/auth/gmail/callback
# GOOGLE_LOGIN_REDIRECT_URI=http://localhost:5000/api/auth/google/callback

# # AI Gateway (OpenAI GPT models for every AI feature)
# # OPENAI_MODEL is the default model; OPENAI_FALLBACK_MODEL is tried once on a retryable failure.
# OPENAI_MODEL=gpt-5.4-mini
# OPENAI_FALLBACK_MODEL=
# OPENAI_API_KEY=sk-...
# OPENAI_BASE_URL=https://api.openai.com/v1
# # All users, including admins, need prepaid credit for AI features.
# # Standard gpt-5.4-mini USD cents/million, verified 2026-10-28: https://developers.openai.com/api/docs/pricing
# # Other models require all three verified rates; unknown prices block AI requests.
# AI_CREDIT_INPUT_CENTS_PER_MILLION=75
# AI_CREDIT_CACHED_INPUT_CENTS_PER_MILLION=7.5
# AI_CREDIT_OUTPUT_CENTS_PER_MILLION=450
# OPENAI_TIMEOUT_MS=120000

# # Push notifications (FCM legacy key used by server push dispatcher)
# # FCM_SERVER_KEY=your_fcm_legacy_server_key
# # FIREBASE_SERVER_KEY=your_fcm_legacy_server_key

# # Firebase Admin (required for file/image uploads and FCM v1)
# # FIREBASE_PROJECT_ID=your_firebase_project_id
# # FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project.iam.gserviceaccount.com
# # FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
# # FIREBASE_STORAGE_BUCKET=your-project.appspot.com
# # Local-only fallback to load ./smile3-service-account.json when env vars are absent.
# # Keep unset/false in production.
# # ALLOW_LOCAL_SERVICE_ACCOUNT=false

# # --- Production (e.g. Heroku) - set these in Heroku Config Vars ---
# # CLIENT_URL=https://your-app.herokuapp.com
# # GOOGLE_REDIRECT_URI=https://your-app.herokuapp.com/api/auth/gmail/callback
# GOOGLE_LOGIN_REDIRECT_URI=https://your-app.herokuapp.com/api/auth/google/callback
# # In Google Cloud Console, add the production redirect URIs above to your OAuth 2.0 client.

# # Google Classroom assignment publishing (off by default)
# # GOOGLE_CLASSROOM_ENABLED=false
# # Shared Classroom + Forms + Gmail connection callback. Register this exact URI in Google Cloud
# # even if Classroom publishing itself is disabled but Google Forms is enabled.
# # For local development, use CLIENT_URL=http://localhost:5173 and
# # PORTAL_URL=http://localhost:5173/portal with the localhost callback below.
# # GOOGLE_CLASSROOM_REDIRECT_URI=http://localhost:5000/api/auth/google-classroom/callback
# # GOOGLE_CLASSROOM_REDIRECT_URI=https://your-api-domain/api/auth/google-classroom/callback
# # Optional comma-separated school IDs for a pilot; when empty, every school may use it once enabled
# # GOOGLE_CLASSROOM_SCHOOL_IDS=
# # Optional separate secret for signing OAuth state (falls back to JWT_SECRET)
# # GOOGLE_CLASSROOM_OAUTH_STATE_SECRET=
# # Required so Classroom tokens are stored encrypted
# # APP_SECRET_ENCRYPTION_KEY=

# # Google Forms quiz assignments (off by default; shares GOOGLE_CLIENT_ID/SECRET and consent with Classroom/Gmail)
# # GOOGLE_FORMS_ENABLED=false
# # Dedicated Forms credentials are only needed to retain/migrate older separate Forms grants.
# # GOOGLE_FORMS_CLIENT_ID=your_forms_oauth_client_id.apps.googleusercontent.com
# # GOOGLE_FORMS_CLIENT_SECRET=your_forms_oauth_client_secret
# # GOOGLE_FORMS_REDIRECT_URI=http://localhost:5000/api/auth/google-forms/callback
# # GOOGLE_FORMS_REDIRECT_URI=https://your-api-domain/api/auth/google-forms/callback
# # Optional comma-separated school IDs for a pilot; when empty, all schools may use the feature
# # GOOGLE_FORMS_SCHOOL_IDS=
# # Optional Forms-specific OAuth-state secret (falls back to JWT_SECRET)
# # GOOGLE_FORMS_OAUTH_STATE_SECRET=
# # Shared consent requests Classroom, Forms, Gmail send, and Gmail modify (sent-mail cleanup) scopes.
# # APP_SECRET_ENCRYPTION_KEY (or ENCRYPTION_KEY) is required to store Google service tokens encrypted.

# # Background job toggles (set to "false" to disable)
# # Attendance reminders always run on scheduler; per-school enable/disable lives in School Settings.
# RUN_NEWSLETTER_ISSUE_SCHEDULER=true
# RUN_SUBSTITUTION_EXPIRY_JOB=true
# RUN_REVIEW_SCHEDULER_JOB=true

# # Smart Review Planner feature flags
# REVIEW_QUEUE_ENABLED=true
# INTERVENTION_QUEUE_ENABLED=true

# # Behavior & Consequence module. Leave unset to keep the per-school
# # behavior_settings.enabled flag authoritative (the in-app admin toggle).
# # When set, the environment wins: every school is on/ off and the in-app
# # toggle has no effect.
# # BEHAVIOR_SYSTEM_ENABLED=true
# # BEHAVIOR_SYSTEM_ENABLED=false
# # The hourly status sweep reads behavior_settings directly, so it only runs for
# # schools whose stored flag is true, regardless of the override above.
# RUN_BEHAVIOR_STATUS_JOB=true
# # Parent email delivery. OFF by default: with this unset the dispatcher reports
# # what it would send and changes nothing, so the queue can be inspected without
# # reaching a family. A message still needs the school's own email switch and the
# # step's approval, and it sends from a connected school admin Gmail account.
# # BEHAVIOR_EMAIL_DELIVERY=true

# Writing feedback emails. OFF by default. Values: off | students | parents | both.
# Publishing feedback then emails the chosen people a short message: which piece and
# draft, what the teacher asked for next, and a link. No scores and no draft text.
# The teacher can untick a channel for a single publish; they cannot add one here.
# WRITING_EMAIL_DELIVERY=off

# Interactive CSV live lessons (also set VITE_LIVE_LESSONS_ENABLED=true in the client build)
# LIVE_LESSONS_ENABLED=false

# # Timezone fallback for school-based scheduling/reminders (IANA format)
# DEFAULT_SCHOOL_TIMEZONE=UTC
