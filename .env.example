# Server Configuration
PORT=5000
NODE_ENV=development

# MongoDB Configuration
MONGODB_URI=mongodb://localhost:27017/gradebook

# JWT Configuration
JWT_SECRET=your_super_secret_jwt_key_change_in_productionnn
JWT_EXPIRE=7d
JWT_REFRESH_SECRET=your_refresh_secret_change_in_production
JWT_REFRESH_EXPIRE=30d

# Email Configuration (for notifications)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
FROM_EMAIL=noreply@gradebook.com
FROM_NAME=GradeBook

# Google OAuth Configuration (for Gmail API + Login)
# Get these from Google Cloud Console: https://console.cloud.google.com/
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret
# Redirect URIs must match exactly what you set in Google Cloud Console → APIs → Credentials → OAuth 2.0
# GOOGLE_REDIRECT_URI=http://localhost:5000/api/auth/gmail/callback
# GOOGLE_LOGIN_REDIRECT_URI=http://localhost:5000/api/auth/google/callback

# Gemini AI Configuration
GEMINI_API_KEY=your_gemini_api_key

# Push notifications (FCM legacy key used by server push dispatcher)
# FCM_SERVER_KEY=your_fcm_legacy_server_key
# FIREBASE_SERVER_KEY=your_fcm_legacy_server_key

# Firebase Admin (required for file/image uploads and FCM v1)
# FIREBASE_PROJECT_ID=your_firebase_project_id
# FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project.iam.gserviceaccount.com
# FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
# FIREBASE_STORAGE_BUCKET=your-project.appspot.com

# --- Production (e.g. Heroku) - set these in Heroku Config Vars ---
# CLIENT_URL=https://your-app.herokuapp.com
# GOOGLE_REDIRECT_URI=https://your-app.herokuapp.com/api/auth/gmail/callback
# GOOGLE_LOGIN_REDIRECT_URI=https://your-app.herokuapp.com/api/auth/google/callback
# In Google Cloud Console, add the production redirect URIs above to your OAuth 2.0 client.

# Background job toggles (set to "false" to disable)
RUN_ATTENDANCE_REMINDER_JOB=true
RUN_NEWSLETTER_ISSUE_SCHEDULER=true
RUN_SUBSTITUTION_EXPIRY_JOB=true
RUN_REVIEW_SCHEDULER_JOB=true

# Smart Review Planner feature flags
REVIEW_QUEUE_ENABLED=true
INTERVENTION_QUEUE_ENABLED=true

# Timezone fallback for school-based scheduling/reminders (IANA format)
DEFAULT_SCHOOL_TIMEZONE=UTC
