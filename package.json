{
  "name": "grade-book-server",
  "version": "1.0.0",
  "description": "Student Grade Management System - Backend API",
  "main": "server.js",
  "type": "module",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "seed": "node seeds/seedData.js",
    "test": "node --test tests/**/*.test.js",
    "test:reminder": "node scripts/test-attendance-reminder.js",
    "test:newsletter": "node scripts/test-newsletter-utils.js",
    "pl": "node  scripts/playground.js",
    "lint": "eslint .",
    "deploy": "git add . ; git commit -m \"Deployment\" ; git push heroku main",
    "heroku-postbuild": "cd client && npm install && npm run build"
  },
  "keywords": [
    "mern",
    "grades",
    "students",
    "education"
  ],
  "author": "",
  "license": "ISC",
  "engines": {
    "node": "20.x"
  },
  "dependencies": {
    "@google/genai": "^1.39.0",
    "bcryptjs": "^2.4.3",
    "compression": "^1.8.1",
    "cors": "^2.8.5",
    "date-fns": "^4.1.0",
    "dotenv": "^16.4.5",
    "express": "^4.21.0",
    "express-mongo-sanitize": "^2.2.0",
    "express-rate-limit": "^8.2.1",
    "express-validator": "^7.0.1",
    "firebase-admin": "^13.7.0",
    "geoip-lite": "^1.4.10",
    "googleapis": "^170.1.0",
    "helmet": "^8.1.0",
    "hpp": "^0.2.3",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.4.1",
    "multer": "^2.0.2",
    "nodemailer": "^6.9.13",
    "useragent": "^2.3.0",
    "ws": "^8.19.0",
    "xss": "^1.0.15",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@eslint/js": "^9.15.0",
    "eslint": "^9.15.0",
    "globals": "^15.12.0",
    "nodemon": "^3.1.3"
  }
}
